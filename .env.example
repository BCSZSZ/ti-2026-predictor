# Optional paid OpenDota key. Never commit a real value or pass it on the command line.
OPENDOTA_API_KEY=

# Local UTC-month ceiling for keyed request attempts. It may be lowered, but not raised above 50000.
OPENDOTA_MONTHLY_REQUEST_LIMIT=50000

# Optional. The MVP works with OpenDota only.
STRATZ_TOKEN=

# Optional explicit paths for local rule extraction.
DOTA_PATH=C:\Program Files (x86)\Steam\steamapps\common\dota 2 beta\game\dota
VRF_CLI=
